# ==================== GENERAL ====================
NODE_ENV=development
APP_NAME=Photobooth Studio System
APP_VERSION=2.0.0

# ==================== BACKEND ====================
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000

# Database PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/photobooth_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ==================== CLOUDINARY ====================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================== UPLOADER APP ====================
UPLOADER_API_URL=http://localhost:5000/api
UPLOADER_AUTH_TOKEN=your_auth_token
MONITOR_FOLDER=C:/Users/Your/Pictures/Photobooth
UPLOADER_DELAY_MS=500
